# FleetMS Environment Configuration
# Copy this to .env and update values

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://fleet_user:fleet_pass@localhost:5432/fleet_db
DATABASE_URL_SYNC=postgresql://fleet_user:fleet_pass@localhost:5432/fleet_db

# ── Security (CHANGE THESE IN PRODUCTION) ────────────────────────────────────
SECRET_KEY=your-super-secret-key-min-32-chars-change-me
SESSION_SECRET_KEY=your-session-secret-key-change-me

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=FleetMS
DEBUG=true
